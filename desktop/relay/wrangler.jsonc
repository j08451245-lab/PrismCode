{
  // PrismCode Connect relay: sign-in, device list and encrypted frame forwarding. See README.md.
  "name": "prismcode-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  // Serve the relay from your own Cloudflare zone: uncomment and replace the
  // pattern. Without a route, wrangler deploy uses the workers.dev URL.
  // "routes": [{ "pattern": "relay.example.com", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ACCOUNT_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
